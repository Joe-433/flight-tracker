#!/usr/bin/env bash
# Run a fare scan right now.
#
#   ./scan            calendar scans + the configured number of full searches
#   ./scan 120        calendar scans + 120 full searches (a deep scan)
#
# Prefers a local live run if one is set up (instant, no GitHub round trip);
# otherwise dispatches the GitHub Actions workflow and streams the result back.
# Either way, alerts fire normally -- this is the same code path as the cron.

set -euo pipefail
cd "$(dirname "$0")"

DRILLS="${1:-}"
if [ -n "$DRILLS" ] && ! [[ "$DRILLS" =~ ^[0-9]+$ ]]; then
  echo "usage: ./scan [number-of-full-searches]" >&2
  exit 2
fi

# --- local path: only if a Python with the scraper installed is present -------
for candidate in .venv-live/bin/python python3.13 python3.12 python3.11 python3.10; do
  PY="$(command -v "$candidate" 2>/dev/null || true)"
  [ -n "$PY" ] || continue
  if PYTHONPATH=src "$PY" -c "import fast_flights" >/dev/null 2>&1; then
    echo "scanning locally via $PY"
    exec env PYTHONPATH=src "$PY" -m flight_tracker run --console ${DRILLS:+--drills "$DRILLS"}
  fi
done

# --- remote path -------------------------------------------------------------
command -v gh >/dev/null || { echo "need either a local Python >=3.10 with deps, or gh" >&2; exit 1; }

echo "no local scraper; dispatching GitHub Actions..."
latest() { gh run list --workflow="watch fares" --limit 1 --json databaseId --jq '.[0].databaseId // 0'; }
before="$(latest)"
gh workflow run "watch fares" ${DRILLS:+-f drills="$DRILLS"} >/dev/null

# The dispatched run takes a moment to appear; don't grab the previous one.
id="$before"
for _ in $(seq 1 30); do
  sleep 2
  id="$(latest)"
  [ "$id" != "$before" ] && break
done
if [ "$id" = "$before" ]; then
  echo "workflow dispatched but no new run appeared; check: gh run list" >&2
  exit 1
fi

echo "run $id -- https://github.com/Joe-433/flight-tracker/actions/runs/$id"
gh run watch "$id" --exit-status >/dev/null 2>&1 || true
echo
gh run view "$id" --log 2>&1 \
  | grep -E "grid:|plan:|shard [0-9]+:|apply:|  ! |alert:|record low|cheapest|alerts sent|DEAD MAN" \
  | sed 's/^.*[0-9]Z //' | sed 's/^[a-z]*\t[^\t]*\t//'
